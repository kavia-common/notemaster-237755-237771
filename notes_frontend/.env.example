# Frontend configuration (Next.js static export)
#
# The UI calls the backend from the browser, so you must provide a fully-qualified
# base URL that is reachable from the user's browser.
#
# Examples:
# NEXT_PUBLIC_NOTES_API_BASE_URL="http://localhost:8000"
# NEXT_PUBLIC_NOTES_API_BASE_URL="https://your-backend.example.com"

NEXT_PUBLIC_NOTES_API_BASE_URL=""
